{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudMartAuthSSMAccess",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:PutParameter"
      ],
      "Resource": [
        "arn:aws:ssm:ap-south-1:*:parameter/cloudmart/dev/auth/customer-token",
        "arn:aws:ssm:ap-south-1:*:parameter/cloudmart/dev/auth/admin-token"
      ]
    }
  ]
}