{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudMartAuthAndRdsSSMAccess",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:PutParameter"
      ],
      "Resource": [
        "arn:aws:ssm:ap-south-1:*:parameter/cloudmart/*/auth/admin-token",
        "arn:aws:ssm:ap-south-1:*:parameter/cloudmart/*/rds/*"
      ]
    }
  ]
}
